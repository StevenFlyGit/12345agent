# 密钥与本地环境配置（.env 含真实 Key，绝不入库）
.env
.env.*
!frontend/.env.example

# Python 虚拟环境（本机自带，不入库）
.conda/
.venv/
venv/

# Python 缓存与测试缓存
__pycache__/
*.pyc
.pytest_cache/

# Coding Agent 本机缓存与私有状态
.agent/

# 官方原始数据集仅保存在本机（体积大，不入库）
backend/data/raw/official_work_orders/
backend/data/raw/public_policies
信件类别示例工单及录音/

# 本地数据库、日志与运行数据
*.db
*.log
uploads/
backend/storage/
models/

# 前端依赖与构建中间产物
# 注意：frontend/dist 为预构建产物，已提交仓库，便于无 Node.js 环境也直接运行演示
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# 编辑器与系统文件
.vscode/settings.json
Thumbs.db
Desktop.ini
.DS_Store
