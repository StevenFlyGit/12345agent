# 本机密钥与环境变量
.env
.env.*
!.env.example

# Python 与 Conda 虚拟环境
.conda/
.venv/
venv/

# Python 缓存与测试缓存
__pycache__/
*.pyc
.pytest_cache/

# Coding Agent 本机缓存、会话和私有状态
.agent/

# 官方原始数据集仅保存在本机
data/raw/official_work_orders/
信件类别示例工单及录音/

# 本地生成的历史工单默认不提交
data/processed/*.jsonl
!data/processed/.gitkeep

# 本地数据库、日志和运行数据
*.db
*.log
uploads/
storage/
models/

# 编辑器本机配置
.vscode/settings.json

# Windows 与 macOS 系统文件
Thumbs.db
Desktop.ini
.DS_Store
